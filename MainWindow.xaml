<Window x:Class="network_test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网络测试工具" Height="780" Width="1020" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#1F1F1F"
        WindowStyle="None" ResizeMode="CanResize" Icon="app.ico"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2F6FED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#245BD0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#3E4C7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8"
                                Padding="14,11" Margin="10,3">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2F6FED"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏按钮 -->
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3F3F3F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseTitleButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#9E2317"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色下拉框 -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MaxDropDownHeight" Value="240"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="#333333" BorderBrush="#4A4A4A"
                                                BorderThickness="1" CornerRadius="6">
                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#B0B0B0" StrokeThickness="1.4"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,12,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#5C5C5C"/>
                                                <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="12,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border Background="#2E2E2E" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="6"
                                        MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,0,0" Padding="2">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#DADADA"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2F6FED"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色进度条 -->
        <Style x:Key="DarkProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="#2F6FED"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#3A3A3A" CornerRadius="3">
                            <Grid>
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                        CornerRadius="3" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="#2B2B2B" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="8,6">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="#9A9A9A" FontSize="12"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 自定义标题栏（深色） ===== -->
        <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Image Source="app.ico" Width="16" Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <TextBlock Text="网络测试工具" Foreground="#DCDCDC" FontSize="12.5" FontWeight="Bold"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <Border Width="1" Height="13" Background="#3A3A3A" Margin="10,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PageTitleText" Text="网络状态" Foreground="#8A8A8A" FontSize="12.5"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinButton" Style="{StaticResource TitleButton}" Content="&#xE921;"
                            Click="Minimize_Click" ToolTip="最小化"/>
                    <Button x:Name="MaxButton" Style="{StaticResource TitleButton}" Content="&#xE922;"
                            Click="Maximize_Click" ToolTip="最大化"/>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseTitleButton}" Content="&#xE8BB;"
                            Click="Close_Click" ToolTip="关闭"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 主体 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="#252526">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,20,18,14">
                        <TextBlock Text="功能导航" FontSize="12" Foreground="#7A7A7A"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Top">
                        <RadioButton x:Name="NavStatus" Style="{StaticResource NavRadio}" GroupName="nav"
                                     Content="网络状态" Tag="0" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSpeed" Style="{StaticResource NavRadio}" GroupName="nav"
                                     Content="网络测速" Tag="1" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavConnect" Style="{StaticResource NavRadio}" GroupName="nav"
                                     Content="连接状态检测" Tag="2" Checked="Nav_Checked"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 右侧内容区 -->
            <Grid Grid.Column="1" Margin="24,18,24,18">

                <!-- 页面1：网络状态（任务管理器风格） -->
                <Grid x:Name="PageStatus">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题行：连接类型大标题 + 适配器描述 -->
                    <DockPanel Grid.Row="0" Margin="2,0,2,10">
                        <TextBlock x:Name="ConnectionTitleText" Text="网络" FontSize="34" FontWeight="Bold"
                                   Foreground="#F0F0F0"/>
                        <TextBlock x:Name="AdapterDescText" Text="" FontSize="15" Foreground="#C8C8C8"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
                    </DockPanel>

                    <!-- 吞吐量图表 -->
                    <Border Grid.Row="1" Background="#202020" BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,14">
                        <Grid Margin="10,6,10,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="吞吐量" FontSize="13" Foreground="#C8C8C8"/>
                            <Border Grid.Row="1" x:Name="ChartBorder" Margin="0,4,0,4">
                                <Canvas>
                                    <Canvas x:Name="GridLinesCanvas"/>
                                    <Polygon x:Name="ChartRecvArea" Fill="#26C7336B"/>
                                    <Polygon x:Name="ChartSendArea" Fill="#26E36BA0"/>
                                    <Polyline x:Name="ChartRecv" Stroke="#C7336B" StrokeThickness="1.6"/>
                                    <Polyline x:Name="ChartSend" Stroke="#E36BA0" StrokeThickness="1.6"/>
                                    <TextBlock x:Name="ChartMaxText" Text="" FontSize="11" Foreground="#9A9A9A"/>
                                    <TextBlock x:Name="ChartHalfText" Text="" FontSize="11" Foreground="#9A9A9A"/>
                                </Canvas>
                            </Border>
                            <DockPanel Grid.Row="2">
                                <TextBlock Text="30 秒" FontSize="11" Foreground="#8A8A8A"/>
                                <TextBlock Text="0" FontSize="11" Foreground="#8A8A8A" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- 底部：发送/接收速率 + 详细信息 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Rectangle Width="3" Height="16" Fill="#E36BA0" RadiusX="1.5" RadiusY="1.5"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="发送" FontSize="14" Foreground="#C8C8C8" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="SendSpeedText" Text="0 Kbps" FontSize="32" FontWeight="Bold"
                                       Foreground="#F0F0F0" Margin="11,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Rectangle Width="3" Height="16" Fill="#C7336B" RadiusX="1.5" RadiusY="1.5"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="接收" FontSize="14" Foreground="#C8C8C8" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="RecvSpeedText" Text="0 Kbps" FontSize="32" FontWeight="Bold"
                                       Foreground="#F0F0F0" Margin="11,0,0,0"/>
                        </StackPanel>

                        <Grid Grid.Column="1" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style x:Key="DetailLabel" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#9A9A9A"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,14,12"/>
                                </Style>
                                <Style x:Key="DetailValue" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#E8E8E8"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Margin" Value="0,0,0,12"/>
                                </Style>
                            </Grid.Resources>
                            <TextBlock Grid.Row="0" Text="适配器名称:" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AdapterNameText" Text="—" Style="{StaticResource DetailValue}"/>
                            <TextBlock Grid.Row="1" Text="SSID:" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SsidText" Text="—" Style="{StaticResource DetailValue}"/>
                            <TextBlock Grid.Row="2" Text="连接类型:" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ConnTypeText" Text="—" Style="{StaticResource DetailValue}"/>
                            <TextBlock Grid.Row="3" Text="IPv4 地址:" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="Ipv4Text" Text="—" Style="{StaticResource DetailValue}"/>
                            <TextBlock Grid.Row="4" Text="IPv6 地址:" Style="{StaticResource DetailLabel}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="Ipv6Text" Text="—" Style="{StaticResource DetailValue}"/>
                            <TextBlock Grid.Row="5" Text="信号强度:" Style="{StaticResource DetailLabel}"/>
                            <Grid Grid.Row="5" Grid.Column="1" Height="26" Margin="0,0,0,12">
                                <StackPanel x:Name="SignalBars" Orientation="Horizontal" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 页面2：网络测速 -->
                <Grid x:Name="PageSpeed" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="网络测速" Style="{StaticResource SectionHeader}"/>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="测速端点" Foreground="#9A9A9A" FontSize="13" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="EndpointCombo" Style="{StaticResource DarkComboBox}"
                                                  Width="220" Margin="12,0,0,0" SelectionChanged="EndpointCombo_SelectionChanged"/>
                                    </StackPanel>
                                    <TextBlock x:Name="EndpointHintText" Text="" FontSize="12" Foreground="#7A7A7A"
                                               Margin="0,2,0,10" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="SpeedStatusText" Text="点击下方按钮开始测速（全程约 20 秒）" FontSize="14" Foreground="#C8C8C8"/>
                                    <ProgressBar x:Name="SpeedProgress" Style="{StaticResource DarkProgress}" Height="8"
                                                 Minimum="0" Maximum="100" Margin="0,14,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button x:Name="StartSpeedTestButton" Content="开始测速" Style="{StaticResource PrimaryButton}" Click="StartSpeedTest_Click"/>
                                        <Button x:Name="CancelSpeedTestButton" Content="取消" Margin="10,0,0,0"
                                                Style="{StaticResource PrimaryButton}" Background="#6B7280" Click="CancelSpeedTest_Click" Visibility="Collapsed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 实时吞吐量（与“网络状态”页同款图表） -->
                            <Border Background="#202020" BorderBrush="#333333" BorderThickness="1" Height="168" Margin="0,14,0,0">
                                <Grid Margin="10,6,10,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="实时吞吐量" FontSize="13" Foreground="#C8C8C8"/>
                                    <Border Grid.Row="1" x:Name="SpeedChartBorder" Margin="0,4,0,4">
                                        <Canvas>
                                            <Canvas x:Name="SpeedGridLinesCanvas"/>
                                            <Polygon x:Name="SpeedChartRecvArea" Fill="#26C7336B"/>
                                            <Polygon x:Name="SpeedChartSendArea" Fill="#26E36BA0"/>
                                            <Polyline x:Name="SpeedChartRecv" Stroke="#C7336B" StrokeThickness="1.6"/>
                                            <Polyline x:Name="SpeedChartSend" Stroke="#E36BA0" StrokeThickness="1.6"/>
                                            <TextBlock x:Name="SpeedChartMaxText" Text="" FontSize="11" Foreground="#9A9A9A"/>
                                            <TextBlock x:Name="SpeedChartHalfText" Text="" FontSize="11" Foreground="#9A9A9A"/>
                                        </Canvas>
                                    </Border>
                                    <DockPanel Grid.Row="2">
                                        <TextBlock Text="30 秒" FontSize="11" Foreground="#8A8A8A"/>
                                        <TextBlock Text="0" FontSize="11" Foreground="#8A8A8A" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </Grid>
                            </Border>

                            <UniformGrid Columns="3" Margin="0,14,0,0">
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="下载速度" Style="{StaticResource CardLabel}"/>
                                        <TextBlock x:Name="SpeedDlText" Text="—" Style="{StaticResource CardValue}" Foreground="#6FA8FF"/>
                                        <TextBlock x:Name="DlDetailText" Text="—" FontSize="12" Foreground="#9A9A9A" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="上传速度" Style="{StaticResource CardLabel}"/>
                                        <TextBlock x:Name="SpeedUlText" Text="—" Style="{StaticResource CardValue}" Foreground="#F0B429"/>
                                        <TextBlock x:Name="UlDetailText" Text="—" FontSize="12" Foreground="#9A9A9A" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="延迟（Ping）" Style="{StaticResource CardLabel}"/>
                                        <TextBlock x:Name="SpeedPingText" Text="— ms" Style="{StaticResource CardValue}"/>
                                        <TextBlock x:Name="SpeedJitterText" Text="抖动 — ms" FontSize="12" Foreground="#9A9A9A" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- 综合评分 -->
                            <Border x:Name="ScoreCard" Style="{StaticResource Card}" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,26,0">
                                        <TextBlock x:Name="ScoreText" Text="—" FontSize="54" FontWeight="Bold"
                                                   Foreground="#8A8A8A" VerticalAlignment="Center"/>
                                        <TextBlock Text="/100" FontSize="13" Foreground="#8A8A8A"
                                                   VerticalAlignment="Bottom" Margin="6,0,0,14"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="综合评分" FontSize="13" Foreground="#9A9A9A" VerticalAlignment="Center"/>
                                            <Border x:Name="GradeBadge" Background="#2E2E2E" CornerRadius="9"
                                                    Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="GradeText" Text="待测速" FontSize="12" FontWeight="Bold"
                                                           Foreground="#9A9A9A"/>
                                            </Border>
                                        </StackPanel>

                                        <ProgressBar x:Name="ScoreBar" Style="{StaticResource DarkProgress}"
                                                     Minimum="0" Maximum="100" Value="0" Margin="0,10,0,0"
                                                     Foreground="#6FCF97"/>

                                        <TextBlock x:Name="ScoreCommentText"
                                                   Text="完成一次测速后，会根据下载速度、上传速度、延迟和抖动给出综合评分。"
                                                   FontSize="12" Foreground="#9A9A9A" Margin="0,10,0,0" TextWrapping="Wrap"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock x:Name="ScoreDlText" Text="下载 —/45" FontSize="12" Foreground="#8A8A8A" Margin="0,0,20,0"/>
                                            <TextBlock x:Name="ScoreUlText" Text="上传 —/20" FontSize="12" Foreground="#8A8A8A" Margin="0,0,20,0"/>
                                            <TextBlock x:Name="ScorePingText" Text="延迟 —/25" FontSize="12" Foreground="#8A8A8A" Margin="0,0,20,0"/>
                                            <TextBlock x:Name="ScoreJitterText" Text="抖动 —/10" FontSize="12" Foreground="#8A8A8A"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 页面3：连接状态检测 -->
                <Grid x:Name="PageConnect" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="连接状态检测" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="HintText" Text="当前没有可用的网络连接，已自动跳转到本页。"
                                       Foreground="#F0B429" Background="#3A2F16" Padding="12,8"
                                       Visibility="Collapsed"/>
                            <Border x:Name="OverallBanner" Style="{StaticResource Card}" Margin="0,12,0,0">
                                <TextBlock x:Name="OverallText" Text="点击下方「开始检测」按钮检查当前网络连接状态。"
                                           FontSize="15" FontWeight="Bold" Foreground="#C8C8C8"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="RecheckButton" Content="开始检测" Style="{StaticResource PrimaryButton}" Click="Recheck_Click"/>
                            </StackPanel>
                            <Border Background="#262626" BorderBrush="#3A3A3A" BorderThickness="1"
                                    CornerRadius="8" Margin="0,14,0,0" Padding="0,6,0,8">
                                <StackPanel>
                                    <!-- 表头 -->
                                    <Grid Margin="12,4,12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="结果" Foreground="#8A8A8A" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="检测项" Foreground="#8A8A8A" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="详情" Foreground="#8A8A8A" FontSize="12"/>
                                    </Grid>
                                    <Border Height="1" Background="#3A3A3A" Margin="0,0,0,6"/>

                                    <ListBox x:Name="CheckList" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="{Binding RowBg}"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Cursor" Value="Arrow"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Grid>
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Margin="10,2">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <!-- 悬停/选中用低透明度覆盖层，避免系统默认的白色高亮 -->
                                                                <Border x:Name="Overlay" Background="Transparent" CornerRadius="6" Margin="10,2"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Overlay" Property="Background" Value="#14FFFFFF"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Overlay" Property="Background" Value="#24FFFFFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,8,10,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4"/>
                                                        <ColumnDefinition Width="74"/>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 左侧状态色条 -->
                                                    <Border Grid.Column="0" Background="{Binding Accent}" CornerRadius="2" Margin="0,1"
                                                            HorizontalAlignment="Left" Width="3"/>
                                                    <!-- 状态徽标 -->
                                                    <Border Grid.Column="1" Background="{Binding BadgeBg}" CornerRadius="9"
                                                            Padding="8,2" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Icon}" Foreground="{Binding Foreground}"
                                                                   FontSize="12" FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{Binding NameBrush}"
                                                               FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Detail}" Foreground="{Binding DetailBrush}"
                                                               FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
